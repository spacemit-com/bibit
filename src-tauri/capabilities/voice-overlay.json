{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "voice-overlay",
  "description": "Permissions for the Bibit Voice input overlay",
  "windows": [
    "voice-overlay"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "log:default",
    "store:default",
    "os:default",
    "vector-db:default",
    "rag:default",
    "websearch:default",
    "hardware:default",
    "llamacpp:default"
  ]
}
