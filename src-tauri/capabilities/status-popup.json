{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "status-popup",
  "description": "Minimal permissions for the BiBit quick conversation window",
  "windows": ["status-popup"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:event:allow-listen",
    "core:webview:allow-set-webview-zoom",
    "log:default",
    "store:default",
    "os:default",
    "vector-db:default",
    "rag:default",
    "websearch:default",
    "hardware:default",
    "llamacpp:default"
  ]
}
