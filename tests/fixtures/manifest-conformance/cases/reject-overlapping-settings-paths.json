{
  "name": "reject-overlapping-settings-paths",
  "expect": "reject",
  "note": "Nested settings paths collide.",
  "manifest": {
    "manifestSchemaVersion": 1,
    "sdkApiVersion": 1,
    "id": "conformance",
    "version": "0.1.0",
    "owner": "platform-team",
    "display": {
      "titleKey": "conformance:title",
      "fallbackTitle": "Conformance",
      "iconKey": "feature"
    },
    "targets": [
      "desktop"
    ],
    "requiredHostCapabilities": [],
    "contributions": {
      "pages": [],
      "settings": [
        {
          "id": "alpha",
          "path": "alpha",
          "surfaces": [
            "main"
          ]
        },
        {
          "id": "beta",
          "path": "alpha/beta",
          "surfaces": [
            "main"
          ]
        }
      ],
      "conversation": [],
      "locales": [
        "en"
      ]
    }
  }
}
