      "titleKey": "icon-keys:title",
      "fallbackTitle": "Icon keys",
      "iconKey": "sparkles"
    },
    "targets": ["desktop"],
    "requiredHostCapabilities": [],
    "contributions": {
      "pages": [
        {
          "id": "home",
          "path": "",
          "surfaces": ["main"],
          "navigation": { "group": "tools", "order": 100 }
        }
      ],
      "settings": [
        {
          "id": "configure",
          "path": "configure",
          "surfaces": ["main"],
          "navigation": {
            "group": "core",
            "order": 100,
            "fallbackTitle": "Configure",
            "iconKey": "wrench"
          }
        }
      ],
      "conversation": [],
      "locales": ["en"]
    }
  }
}
